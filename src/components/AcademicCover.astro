---
---

<div class="academic-cover-container not-content">
  <!-- Institutional Branding Header -->
  <div class="institutional-header">
    <div class="college-logo-wrapper">
      <img 
        src="/images/amrita-logo.png" 
        alt="Amrita Vishwa Vidyapeetham Logo" 
        class="college-logo-img"
      />
    </div>
    
    <div class="institution-details">
      <h2 class="institution-name">AMRITA VISHWA VIDYAPEETHAM, COIMBATORE</h2>
      <h3 class="dept-name">DEPARTMENT OF COMPUTER SCIENCE AND ENGINEERING</h3>
      <span class="cluster-tag">KNOWLEDGE ENGINEERING AND SEMANTIC COMPUTING</span>
    </div>
  </div>

  <div class="cover-divider"></div>

  <!-- Academic Project Identification -->
  <div class="project-identity-section">
    <div class="project-badges-row">
      <span class="project-badge">ACADEMIC RESEARCH PROJECT</span>
      <span class="team-number-pill">TEAM 42</span>
    </div>
    <h1 class="project-title-main">An Evolutionary Framework for Ransomware Defense Optimization</h1>
  </div>

  <!-- Supervisory Committee (Guide & Co-Guide) -->
  <div class="supervision-grid">
    <div class="supervision-card">
      <span class="supervision-role-badge">PROJECT GUIDE</span>
      <h3 class="supervisor-name">Ms. Rohini S</h3>
      <p class="supervisor-designation">Assistant Professor</p>
      <p class="supervisor-dept">Department of Computer Science & Engineering</p>
      <p class="supervisor-inst">Amrita Vishwa Vidyapeetham, Coimbatore</p>
    </div>

    <div class="supervision-card">
      <span class="supervision-role-badge">PROJECT CO-GUIDE</span>
      <h3 class="supervisor-name">Dr. Gowtham R</h3>
      <p class="supervisor-designation">Associate Professor</p>
      <p class="supervisor-dept">Department of Computer Science & Engineering</p>
      <p class="supervisor-inst">Amrita Vishwa Vidyapeetham, Coimbatore</p>
    </div>
  </div>

  <!-- Team Members Table -->
  <div class="team-members-section">
    <div class="team-header-bar">
      <span class="team-number-tag">TEAM 42</span>
      <h3 class="team-heading">PROJECT TEAM MEMBERS</h3>
      <span class="team-batch-tag">B.Tech CSE (Batch 2023–2027)</span>
    </div>

    <div class="cover-table-wrapper">
      <table class="academic-cover-table">
        <thead>
          <tr>
            <th class="col-sno">S.No</th>
            <th class="col-reg">Register Number</th>
            <th class="col-name">Student Name</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="col-sno">1</td>
            <td class="col-reg font-mono">CB.SC.U4CSE23720</td>
            <td class="col-name font-semibold">Guru D</td>
          </tr>
          <tr>
            <td class="col-sno">2</td>
            <td class="col-reg font-mono">CB.SC.U4CSE23739</td>
            <td class="col-name font-semibold">Parvathy Krishna A</td>
          </tr>
          <tr>
            <td class="col-sno">3</td>
            <td class="col-reg font-mono">CB.SC.U4CSE23743</td>
            <td class="col-name font-semibold">Shivanesh M C</td>
          </tr>
          <tr>
            <td class="col-sno">4</td>
            <td class="col-reg font-mono">CB.SC.U4CSE23755</td>
            <td class="col-name font-semibold">Vijeya Varshini G</td>
          </tr>
          <tr>
            <td class="col-sno">5</td>
            <td class="col-reg font-mono">CB.SC.U4CSE23758</td>
            <td class="col-name font-semibold">Vimal Sabari S B</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Portal Entry Action -->
  <div class="portal-entry-action">
    <a href="/overview/introduction/" class="btn-enter-portal">
      <span>Enter Documentation Portal</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>

  <!-- Bottom Academic Footnote -->
  <div class="cover-footer-note">
    <span>Department of Computer Science and Engineering • Amrita Vishwa Vidyapeetham, Coimbatore</span>
    <span>Academic Year 2025–2026</span>
  </div>
</div>
