---
interface Props {
  title: string;
  figureNumber?: string;
  caption?: string;
  status?: string;
}

const {
  title,
  figureNumber,
  caption = "Architecture diagram and workflow visualization placeholder. Vector SVG or Mermaid specification will be linked here upon experimental finalization.",
  status = "Diagram placeholder"
} = Astro.props;
---

<div class="workflow-diagram-container">
  <div class="workflow-header">
    <h4 class="workflow-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="3" y1="9" x2="21" y2="9"></line>
        <line x1="9" y1="21" x2="9" y2="9"></line>
      </svg>
      {figureNumber ? `${figureNumber}: ${title}` : title}
    </h4>
    <span class="workflow-status">{status}</span>
  </div>
  <div class="workflow-body">
    <slot>
      <div style="display: flex; flex-direction: column; align-items: center; gap: 0.75rem; text-align: center; color: var(--sl-color-gray-4); padding: 1rem;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <span style="font-size: 0.9rem; font-weight: 500; color: var(--sl-color-gray-2);">{title} Diagram Area</span>
        <span style="font-size: 0.8rem; max-width: 420px;">[SVG / Mermaid Architecture or Sequence Flow Diagram will be inserted here]</span>
      </div>
    </slot>
  </div>
  {caption && <p class="workflow-caption"><strong>Note:</strong> {caption}</p>}
</div>
